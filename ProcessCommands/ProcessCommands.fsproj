<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        
        <!-- nuget package metadata: -->
        <Version>1.0.0</Version>
        <Authors>DFU398</Authors>
        <Copyright>Copyright (c) 2026 DFU398</Copyright>
        <Description>Convenience wrapper around System.Diagnostics.Process.Start for easily running another executable from your .NET code.</Description>
        <PackageTags>Process, Process.Start, System.Diagnostics.Process, System.Diagnostics.Process.Start</PackageTags>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageProjectUrl>https://github.com/DFU398/ProcessCommands</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/DFU398/ProcessCommands/releases</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/DFU398/ProcessCommands.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    
    <ItemGroup>
        <Content Include="..\LICENSE">
            <PackagePath>\</PackagePath>
            <Visible>false</Visible>
            <Pack>true</Pack>
        </Content>
        <Content Include="..\README.md">
            <PackagePath>\</PackagePath>
            <Visible>false</Visible>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="ICommandResult.fs" />
        <Compile Include="ICommand.fs" />
        <Compile Include="CommandResult.fs" />
        <Compile Include="CommandResultEnvelope.fs" />
        <Compile Include="Command.fs" />
        <Compile Include="CommandEnvelope.fs" />
        <Compile Include="ShellCommand.fs" />
    </ItemGroup>
    
</Project>
